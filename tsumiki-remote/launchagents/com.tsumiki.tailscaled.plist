<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tsumiki.tailscaled</string>

  <!--
    ユーザー権限で動く tailscaled（userspace-networking モード）。
    sudo が要らない代わりに OS のネットワーク層には入らないので、
    「この Mac から他ノードへ出ていく」通信は素通しにならない。
    今回欲しいのは「外の iPhone からこの Mac の 8787 に入ってくる」方向だけなので、
    これで足りる（入ってきた接続は localhost の同じポートへ転送される）。
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/tailscaled</string>
    <string>--tun=userspace-networking</string>
    <string>--socket=/Users/ko_dai/.tsumiki-remote/tailscaled.sock</string>
    <string>--state=/Users/ko_dai/.tsumiki-remote/tailscaled.state</string>
    <string>--port=0</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/ko_dai/.tsumiki-remote/tailscaled.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ko_dai/.tsumiki-remote/tailscaled.log</string>
</dict>
</plist>
