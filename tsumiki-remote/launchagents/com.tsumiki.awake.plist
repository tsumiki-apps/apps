<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tsumiki.awake</string>

  <!--
    -i システムのアイドルスリープを止める（＝眠らない）
    -m ディスクを眠らせない
    -s 電源接続中はシステムスリープを止める
    -d は「画面を眠らせない」なので、あえて付けない。
       蓋は開けたまま画面だけ消えて、中身は動き続ける状態になる。
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-ims</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
