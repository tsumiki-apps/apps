BEGIN:VCALENDAR
PRODID:Microsoft Exchange Server 2010
VERSION:2.0
BEGIN:VTIMEZONE
TZID:Tokyo Standard Time
BEGIN:STANDARD
DTSTART:16010101T000000
TZOFFSETFROM:+0900
TZOFFSETTO:+0900
END:STANDARD
END:VTIMEZONE
BEGIN:VTIMEZONE
TZID:Kodai Custom Zone
BEGIN:STANDARD
DTSTART:16010101T000000
TZOFFSETFROM:+0800
TZOFFSETTO:+0800
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:win-tz@example
SUMMARY:Windows形式のTZID
DTSTART;TZID="Tokyo Standard Time":20260901T100000
DTEND;TZID="Tokyo Standard Time":20260901T113000
END:VEVENT
BEGIN:VEVENT
UID:custom-tz@example
SUMMARY:VTIMEZONEにしか定義がないTZID
DTSTART;TZID=Kodai Custom Zone:20260902T100000
DTEND;TZID=Kodai Custom Zone:20260902T110000
END:VEVENT
BEGIN:VEVENT
UID:monthly-2tu@example
SUMMARY:第2火曜の定例
DTSTART;TZID=Asia/Tokyo:20260811T190000
DTEND;TZID=Asia/Tokyo:20260811T200000
RRULE:FREQ=MONTHLY;BYDAY=2TU;COUNT=3
END:VEVENT
BEGIN:VEVENT
UID:no-dtend@example
SUMMARY:DTENDもDURATIONも無い
DTSTART;TZID=Asia/Tokyo:20260903T120000
END:VEVENT
END:VCALENDAR
