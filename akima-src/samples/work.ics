BEGIN:VCALENDAR
PRODID:-@k//test//JA
VERSION:2.0
CALSCALE:GREGORIAN
METHOD:PUBLISH
BEGIN:VTIMEZONE
TZID:Asia/Tokyo
BEGIN:STANDARD
DTSTART:19700101T000000
TZOFFSETFROM:+0900
TZOFFSETTO:+0900
TZNAME:JST
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:shift-normal@example
SUMMARY:早番 レジ担当
LOCATION:店舗バックヤード
DESCRIPTION:このテキストは絶対に取り込まれてはいけない
ATTENDEE;CN=Someone Else:mailto:someone@example.com
DTSTART;TZID=Asia/Tokyo:20260803T090000
DTEND;TZID=Asia/Tokyo:20260803T180000
END:VEVENT
BEGIN:VEVENT
UID:shift-late@example
SUMMARY:遅番
DTSTART;TZID=Asia/Tokyo:20260804T130000
DTEND;TZID=Asia/Tokyo:20260804T220000
END:VEVENT
BEGIN:VEVENT
UID:shift-overnight@example
SUMMARY:夜勤（日またぎ）
DTSTART;TZID=Asia/Tokyo:20260805T220000
DTEND;TZID=Asia/Tokyo:20260806T070000
END:VEVENT
BEGIN:VEVENT
UID:allday-off@example
SUMMARY:公休
DTSTART;VALUE=DATE:20260807
DTEND;VALUE=DATE:20260808
END:VEVENT
BEGIN:VEVENT
UID:allday-two@example
SUMMARY:連休（2日間）
DTSTART;VALUE=DATE:20260815
DTEND;VALUE=DATE:20260817
END:VEVENT
BEGIN:VEVENT
UID:shift-utc@example
SUMMARY:UTC表記のシフト
DTSTART:20260810T010000Z
DTEND:20260810T100000Z
END:VEVENT
BEGIN:VEVENT
UID:shift-duration@example
SUMMARY:DURATION指定
DTSTART;TZID=Asia/Tokyo:20260811T090000
DURATION:PT8H30M
END:VEVENT
BEGIN:VEVENT
UID:shift-floating@example
SUMMARY:浮動時刻（TZIDもZも無い）
DTSTART:20260812T090000
DTEND:20260812T173000
END:VEVENT
BEGIN:VEVENT
UID:cancelled@example
SUMMARY:中止になったシフト
STATUS:CANCELLED
DTSTART;TZID=Asia/Tokyo:20260813T090000
DTEND;TZID=Asia/Tokyo:20260813T180000
END:VEVENT
BEGIN:VEVENT
UID:transparent@example
SUMMARY:予定ありだけどブロックしない
TRANSP:TRANSPARENT
DTSTART;TZID=Asia/Tokyo:20260814T090000
DTEND;TZID=Asia/Tokyo:20260814T180000
END:VEVENT
BEGIN:VEVENT
UID:weekly-meeting@example
SUMMARY:週次ミーティング
DTSTART;TZID=Asia/Tokyo:20260803T100000
DTEND;TZID=Asia/Tokyo:20260803T110000
RRULE:FREQ=WEEKLY;BYDAY=MO;COUNT=5
EXDATE;TZID=Asia/Tokyo:20260817T100000
END:VEVENT
BEGIN:VEVENT
UID:weekly-meeting@example
SUMMARY:週次ミーティング（時間変更）
RECURRENCE-ID;TZID=Asia/Tokyo:20260824T100000
DTSTART;TZID=Asia/Tokyo:20260824T140000
DTEND;TZID=Asia/Tokyo:20260824T153000
END:VEVENT
BEGIN:VEVENT
UID:daily-until@example
SUMMARY:毎日の朝礼
DTSTART;TZID=Asia/Tokyo:20260901T083000
DTEND;TZID=Asia/Tokyo:20260901T084500
RRULE:FREQ=DAILY;UNTIL=20260904T235959Z
END:VEVENT
BEGIN:VEVENT
UID:folded-line@example
SUMMARY:折り返し行のテスト
DTSTART;TZID=Asia/Toky
 o:20260918T110000
DTEND;TZID=Asia/Tokyo:20260918T120000
