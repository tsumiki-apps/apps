<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.tsumiki.lock</string>
  <key>ProgramArguments</key><array><string>/Users/ko_dai/Applications/TsumikiLock.app/Contents/MacOS/TsumikiLock</string></array>
  <key>RunAtLoad</key><true/>
  <!-- 落ちたら起こし直す。幕が掛かったまま落ちても、起きたときに掛け直す（lock-state.json） -->
